<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.springboot.mapper.CarouselMapper">
    <resultMap id="BaseResultMap" type="com.example.springboot.entity.Carousel">
        <id column="id" property="id" jdbcType="BIGINT"/>
        <result column="name" property="name" jdbcType="VARCHAR"/>
        <result column="value" property="value" jdbcType="VARCHAR"/>
    </resultMap>

    <insert id="insert" parameterType="com.example.springboot.entity.Carousel" useGeneratedKeys="true" keyProperty="id">
        insert into carousel
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="name != null">name,</if>
            <if test="value != null">value,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="name != null">#{name},</if>
            <if test="value != null">#{value},</if>
        </trim>
    </insert>

    <delete id="deleteById" parameterType="java.lang.Long">
        DELETE FROM carousel WHERE id = #{id}
    </delete>

    <delete id="deleteBatchIds" parameterType="java.util.List">
        DELETE FROM carousel WHERE id IN
        <foreach collection="list" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <update id="updateById" parameterType="com.example.springboot.entity.Carousel">
        UPDATE carousel
        SET name = #{name}, value = #{value}
        WHERE id = #{id}
    </update>

    <select id="selectAll" resultMap="BaseResultMap" parameterType="com.example.springboot.entity.Carousel">
        SELECT * FROM carousel
        <where>
            <if test="carousel.name != null and carousel.name != ''">
                AND name LIKE CONCAT('%', #{carousel.name}, '%')
            </if>
        </where>
    </select>
</mapper>